  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API key for authentication"
      },
      "ApiSecretAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Secret",
        "description": "API secret for validation"
      },
      "IpWhitelist": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Forwarded-For",
        "description": "IP address for whitelist validation (automatically handled)"
      },
      "RateLimiting": {
        "type": "apiKey",
        "in": "header",
        "name": "Rate-Limit",
        "description": "Rate limiting (automatically handled, 30 requests per minute)"
      }
    },
    "parameters": {
      "ClientCode": {
        "name": "client_code",
        "in": "query",
        "description": "Filter by client code",
        "required": false,
        "schema": {
          "type": "string",
          "example": "kodam"
        }
      },
      "StartTime": {
        "name": "start",
        "in": "query",
        "description": "Start time in RFC3339 format",
        "required": false,
        "schema": {
          "type": "string",
          "format": "date-time",
          "example": "2025-11-08T00:00:00Z"
        }
      },
      "EndTime": {
        "name": "stop",
        "in": "query",
        "description": "End time in RFC3339 format",
        "required": false,
        "schema": {
          "type": "string",
          "format": "date-time",
          "example": "2025-11-08T23:59:59Z"
        }
      },
      "Page": {
        "name": "page",
        "in": "query",
        "description": "Page number for pagination",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "example": 1
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "description": "Number of items per page",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 50,
          "example": 50
        }
      }
    },
    "schemas": {
      "HealthStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok", "error"],
            "example": "ok"
          }
        },
        "required": ["status"]
      },
      "SensorDataRequest": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp of the sensor data in RFC3339 format",
            "example": "2025-11-08T16:31:00Z"
          },
          "client_code": {
            "type": "string",
            "description": "Client code identifier",
            "example": "kodam"
          },
          "json_data": {
            "type": "string",
            "description": "JSON string containing sensor-specific data",
            "example": "{\"target_id\": \"T001\", \"speed\": 120.5}"
          }
        },
        "required": ["timestamp", "client_code", "json_data"]
      },
      "ApiResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "status": {
            "type": "integer",
            "example": 200
          },
          "status_message": {
            "type": "string",
            "example": "OK"
          },
          "message": {
            "type": "string",
            "example": "Data stored successfully"
          },
          "data": {
            "type": "object",
            "nullable": true,
            "example": null
          }
        },
        "required": ["success", "status", "status_message", "message", "data"]
      },
      "ListResponse": {
        "type": "object",
        "properties": {
          "status": {
