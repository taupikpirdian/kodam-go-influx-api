APP_PORT=3000
ENV_GO=local

# NestJS -> InfluxDB client config
INFLUX_URL=http://147.139.161.159:8086/
INFLUX_TOKEN='iLBD2vEc9_XrwAhA8CeUI0B7s4tgwfwEQ7OW4ZmJfu-W6vOI_vvHe7fePc8sNgmlVxphh-u8rf9Ap75a6Tv7lQ=='
INFLUX_ORG=kodam-org
INFLUX_BUCKET=kodam_dev

# Security settings for /api routes
# Clients must send these headers on every request:
#   X-API-Key: $API_KEY
#   X-API-Secret: $API_SECRET
API_KEY=your-api-key
API_SECRET=your-secret-key

# Comma-separated allowed IPs (optional). Example:
# ALLOWED_IPS=127.0.0.1,192.168.1.10
ALLOWED_IPS=

# Toggle IP whitelist (true/false). If enabled, only ALLOWED_IPS may access /api
ENABLE_IP_WHITELIST=false

# Rate limiting per minute for /api routes (default: 30)
RATE_LIMIT_PER_MINUTE=30